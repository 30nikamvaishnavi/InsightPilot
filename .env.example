# Optional. Without a key the agent uses deterministic answer templates.
# The key is read on the server only; it is never sent to the browser or written to traces.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# lsa (default, offline) or sbert (install requirements-embeddings.txt)
IP_EMBEDDER=lsa
# Optional PostgreSQL URL; when unset SQLite is used.
# DATABASE_URL=postgresql://user:password@localhost:5432/insightpilot
# Optional location for cached document vectors.
# IP_EMBEDDING_CACHE_DIR=data/embedding-cache
# Optional OpenTelemetry OTLP export.
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
